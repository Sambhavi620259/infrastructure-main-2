# Staging / production environment for the ITAM API. TEMPLATE: placeholders only.
# Copy to /etc/itam/itam.env on the server (owner root, mode 600) and fill in. Never commit the real file.
# The API refuses to start in production mode if any of the first four are missing or unsafe.

ENVIRONMENT=production

# Amazon RDS PostgreSQL (private endpoint). Use a URL-encoded password.
DATABASE_URL=postgresql+psycopg2://itam_app:CHANGE_ME@your-db.xxxxxx.eu-west-1.rds.amazonaws.com:5432/itam

# python3 -c "import secrets; print(secrets.token_urlsafe(48))"   (at least 32 characters)
JWT_SECRET=CHANGE_ME

# The address people open in the browser (the CloudFront domain), comma separated. Not *, not localhost.
CORS_ORIGINS=https://your-distribution.cloudfront.net

# How many proxies in front of the API each append an address to X-Forwarded-For.
# CloudFront appends the visitor's address (1); a TLS terminator on the instance (nginx/caddy, with
# `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for`) appends CloudFront's address (2).
# CloudFront + TLS terminator on the instance = 2. A wrong value makes every visitor share one rate-limit key.
# The instance's security group must accept the public port only from CloudFront, or the header can be forged.
TRUSTED_PROXY_COUNT=2

# CloudFront origin verification. The API refuses (403) every request that does not carry
#   X-Origin-Verify: <this value>
# which CloudFront adds as an ORIGIN CUSTOM HEADER on the API origin. This is what stops anyone from calling the
# instance directly and forging X-Forwarded-For. 32+ random characters, different from JWT_SECRET:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep it in AWS Secrets Manager or SSM Parameter Store (SecureString), not in Git, tickets or chat.
# /api/health, /api/health/live and /api/health/ready stay open (deploy.sh and monitors call them on the instance).
# Leave it empty only for local development and Docker: the Next.js proxy used there does not send the header.
ORIGIN_VERIFY_SECRET=CHANGE_ME
# Used ONLY while rotating (the old value, accepted next to the new one). Empty otherwise.
ORIGIN_VERIFY_SECRET_PREVIOUS=

# First Super Admin (created at start-up only if no Super Admin exists yet). Password 12+ characters.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# Public sign-up (all closed by default). Leave false for staging unless you are testing sign-up.
ALLOW_PUBLIC_IT_ADMIN_SIGNUP=false
ALLOW_PUBLIC_AGENT_SIGNUP=false
ALLOW_PUBLIC_SUPER_ADMIN_SIGNUP=false

# Optional tuning
LOG_LEVEL=INFO
AUTH_RATE_LIMIT_PER_MINUTE=20
LOGIN_FAILURE_LIMIT=10
ACCESS_TOKEN_EXPIRE_MINUTES=720
MAX_REQUEST_BODY_BYTES=8388608
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
WEB_CONCURRENCY=1
