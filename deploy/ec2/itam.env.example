# Staging / production environment for the ITAM API. TEMPLATE: placeholders only.
# Copy to /etc/itam/itam.env on the server (owner root, mode 600) and fill in. Never commit the real file.
# The API refuses to start in production mode if any of the first four are missing or unsafe.

ENVIRONMENT=production

# Amazon RDS PostgreSQL (private endpoint). Use a URL-encoded password.
DATABASE_URL=postgresql+psycopg2://itam_app:CHANGE_ME@your-db.xxxxxx.eu-west-1.rds.amazonaws.com:5432/itam

# python3 -c "import secrets; print(secrets.token_urlsafe(48))"   (at least 32 characters)
JWT_SECRET=CHANGE_ME

# The address people open in the browser (the CloudFront domain), comma separated. Not *, not localhost.
CORS_ORIGINS=https://your-distribution.cloudfront.net

# Behind CloudFront only: how many proxies append to X-Forwarded-For. CloudFront = 1.
# Restrict the EC2 security group to CloudFront so nobody can reach port 8000 directly.
TRUSTED_PROXY_COUNT=1

# First Super Admin (created at start-up only if no Super Admin exists yet). Password 12+ characters.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# Public sign-up (all closed by default). Leave false for staging unless you are testing sign-up.
ALLOW_PUBLIC_IT_ADMIN_SIGNUP=false
ALLOW_PUBLIC_AGENT_SIGNUP=false
ALLOW_PUBLIC_SUPER_ADMIN_SIGNUP=false

# Optional tuning
LOG_LEVEL=INFO
AUTH_RATE_LIMIT_PER_MINUTE=20
LOGIN_FAILURE_LIMIT=10
ACCESS_TOKEN_EXPIRE_MINUTES=720
MAX_REQUEST_BODY_BYTES=8388608
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
WEB_CONCURRENCY=1
