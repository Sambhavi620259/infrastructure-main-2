# systemd unit for the ITAM API on Amazon Linux (EC2). TEMPLATE: copy to /etc/systemd/system/itam-backend.service.
# Do not install it from this repository automatically; review the paths and the user first.
[Unit]
Description=ITAM API (FastAPI / uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
# "current" is a symlink to the active release (see deploy.sh). Configuration and secrets live OUTSIDE the release.
WorkingDirectory=/home/ec2-user/itam/current/backend
EnvironmentFile=/etc/itam/itam.env
# Listens on 127.0.0.1 only: the TLS terminator on this instance (nginx/caddy) is the sole client. See deploy/cloudfront/README.md.
# ONE worker: sign-in limits and live-update sockets are held in process memory (see README, "Known limitations").
ExecStart=/home/ec2-user/itam/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-proxy-headers --timeout-graceful-shutdown 20
Restart=on-failure
RestartSec=5
# uvicorn re-raises SIGTERM after a graceful shutdown, so 143 is a clean stop.
SuccessExitStatus=143
KillSignal=SIGTERM
TimeoutStopSec=30
# Logs go to the journal: journalctl -u itam-backend -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=itam-backend
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ec2-user/itam

[Install]
WantedBy=multi-user.target
