# Copy to backend/.env and fill in. Never commit the real .env.

# "production" makes the API refuse to start with the unsafe defaults below.
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://itam_user:itam_password@localhost:5432/itam_db

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Frontend origins allowed to call the API directly (comma separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: create the first Super Admin on startup (password 12+ characters).
# This is how the first Super Admin is created (public Super Admin sign-up is off).
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# Addresses of reverse proxies whose X-Forwarded-For header is believed
# (comma separated IPs/CIDRs). Anything else is treated as the client itself.
TRUSTED_PROXIES=127.0.0.1,::1

# Public sign-up policy. Both default to false in EVERY environment.
# IT Admins are created by a Super Admin; IT Agents by their IT Admin; the first
# Super Admin is seeded below. Set true only for local experiments.
ALLOW_PUBLIC_ADMIN_REGISTRATION=false
# Anyone may sign up as an IT Agent with no organization (a Super Admin places them).
ALLOW_PUBLIC_AGENT_REGISTRATION=false

# Largest accepted request body in bytes (default 2 MB).
MAX_REQUEST_BODY_BYTES=2097152

# Used by docker-compose.yml in this folder.
POSTGRES_USER=itam_user
POSTGRES_PASSWORD=
POSTGRES_DB=itam_db

# Sign-in / registration attempts per client address per minute.
AUTH_RATE_LIMIT_PER_MINUTE=20
