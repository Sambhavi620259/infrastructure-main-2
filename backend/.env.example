# Copy to backend/.env and fill in. Never commit the real .env.

# "production" makes the API refuse to start with the unsafe defaults below.
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://itam_user:itam_password@localhost:5432/itam_db

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Frontend origins allowed to call the API directly (comma separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: create the first Super Admin on startup (password 12+ characters).
# Leave empty to have the first Super Admin register at /register instead.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# Sign-in / registration attempts per client address per minute.
AUTH_RATE_LIMIT_PER_MINUTE=20
