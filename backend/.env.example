# Environment variables go here.
# Project & Server Settings
PROJECT_NAME="ITAM Enterprise API"
API_V1_STR="/api"
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000

# Database Connection
DATABASE_URL="postgresql://itam_user:itam_password@localhost:5432/itam_db"

# JWT Security
JWT_SECRET="production-itam-super-secret-key-change-me-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS Configuration
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"