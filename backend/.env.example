# Copy to backend/.env and fill in. Never commit the real .env.

# "production" makes the API refuse to start with the unsafe defaults below.
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://itam_user:itam_password@localhost:5432/itam_db

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Frontend origins allowed to call the API directly (comma separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: create the first Super Admin on startup (password 12+ characters).
# Leave empty to have the first Super Admin register at /register instead.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# Sign-in / registration attempts per client address per minute.
AUTH_RATE_LIMIT_PER_MINUTE=20

# Failed sign-ins per account (any address) in 15 minutes before it is paused.
LOGIN_FAILURE_LIMIT=10

# How many reverse proxies in front of the API each add to X-Forwarded-For.
# 0 = ignore that header (a caller cannot choose the address the limits see).
# 1 behind one proxy (docker compose), 2 for Vercel -> Render.
TRUSTED_PROXY_COUNT=0

# Who may sign up without being added. Closed by default: a Super Admin adds IT Admins and users.
# Super Admin sign-up closes by itself after the first Super Admin exists.
ALLOW_PUBLIC_IT_ADMIN_SIGNUP=false
ALLOW_PUBLIC_AGENT_SIGNUP=false
ALLOW_PUBLIC_SUPER_ADMIN_SIGNUP=false

# Largest request body in bytes (default 8 MB) and database connections per process.
MAX_REQUEST_BODY_BYTES=8388608
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
