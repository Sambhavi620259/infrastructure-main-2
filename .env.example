# Frontend settings. Copy to .env.local for development.

# Where the Next.js server forwards /api/* requests (server side only).
BACKEND_API_URL=http://127.0.0.1:8000

# WebSocket origin the browser uses for live updates. Leave empty to use the
# page's host on port 8000; set it (wss://...) when the API is behind a domain.
NEXT_PUBLIC_WS_URL=
