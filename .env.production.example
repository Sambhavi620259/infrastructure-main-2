# Values for docker-compose.yml. Copy to .env next to it and fill in.
POSTGRES_USER=itam_user
POSTGRES_PASSWORD=
POSTGRES_DB=itam_db

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# The address people open in the browser, e.g. https://itam.example.com
PUBLIC_APP_URL=http://localhost:3000
# WebSocket address for live updates, e.g. wss://api.itam.example.com (empty = same host, port 8000)
PUBLIC_WS_URL=

# true only if a reverse proxy in front of the frontend sets X-Forwarded-For itself
TRUST_FORWARDED_HEADERS=false

# Public sign-up is closed by default. IT Admins are created by a Super Admin
# (Super Admin > Companies); IT Agents are created by their IT Admin (Users > Create user).
# The first Super Admin comes from SEED_SUPER_ADMIN_* below.
ALLOW_PUBLIC_ADMIN_REGISTRATION=false
# If true, anyone can sign up as an IT Agent with no organization; only a Super Admin can place them.
ALLOW_PUBLIC_AGENT_REGISTRATION=false

# Optional first Super Admin (password 12+ characters)
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
