# Values for docker-compose.yml. Copy to .env next to it and fill in.
POSTGRES_USER=itam_user
POSTGRES_PASSWORD=
POSTGRES_DB=itam_db

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# The address people open in the browser, e.g. https://itam.example.com
PUBLIC_APP_URL=http://localhost:3000
# WebSocket address for live updates, e.g. wss://api.itam.example.com (empty = same host, port 8000)
PUBLIC_WS_URL=

# Optional first Super Admin (password 12+ characters)
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# Sign-up switches (true/false). IT Admins and users are created by the Super Admin, so IT Admin
# and user sign-up are closed by default. A person who signs up on their own has no organization
# until the Super Admin places them.
ALLOW_PUBLIC_IT_ADMIN_SIGNUP=false
ALLOW_PUBLIC_AGENT_SIGNUP=false
ALLOW_PUBLIC_SUPER_ADMIN_SIGNUP=true
